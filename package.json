    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-speech-recognition": "^8.1.10",
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lightningcss": "^1.33.0",
    "lucide-react": "^0.546.0",
